# Copy to .env. Compose reads it; git ignores it.
#
#   cp .env.example .env
#
# Only the planner's provider key is needed to plan. The coding agents get their
# credentials from omnigent's own config (~/.omnigent/config.yaml) on the host,
# not from here -- nothing in this file is forwarded to them.

# --- OMA bridge -----------------------------------------------------------
# Must match [bridge] url in overmind.toml. Changing it here without changing it
# there is the most common cause of `bridge is not reachable`.
OVERMIND_BRIDGE_PORT=7801

# Which model plans. Planning is one call per run, so this is the cheapest place
# in the system to use a strong model.
OVERMIND_PLANNER_PROVIDER=openai
OVERMIND_PLANNER_MODEL=gpt-5.4

# --- provider credentials -------------------------------------------------
# Only the one matching OVERMIND_PLANNER_PROVIDER is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- tracing (optional) ---------------------------------------------------
# Where `overmind export <run-id> --otlp` sends spans. The compose file publishes
# Jaeger's OTLP/HTTP port here; /v1/traces is appended if you omit it.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
